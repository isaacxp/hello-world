# write_grades.py

def main():
    with open('grades.txt', 'w') as f:
        # Header, just like "Account Name Balance"
        print(f"{'Grade':<10}", file=f)

        while True:
            entry = input("Grade (blank to finish): ").strip()
            if not entry:
                break
            try:
                g = float(entry)
            except ValueError:
                print("  → Please enter a number.")
                continue

            # One grade per line, left-aligned in 10 chars
            print(f"{g:<10.2f}", file=f)

if __name__ == "__main__":
    main()

